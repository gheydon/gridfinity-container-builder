  <url type="repository" branch="main">https://github.com/gheydon/gridfinity-container-builder</url>
  <icon>icons/gfcb.svg</icon>
  <content>
    <workbench>
      <classname>GridfinityContainerWorkbench</classname>
      <name>Gridfinity Container</name>
      <description>Create parametric gridfinity bins.</description>
      <icon>icons/gfcb.svg</icon>
    </workbench>
  </content>
</package>
